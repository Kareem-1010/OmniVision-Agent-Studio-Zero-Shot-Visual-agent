# ==============================================================================
# OmniVision Agent Environment Configuration
# ==============================================================================

# LLM Provider API Keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Local / Self-Hosted LLM (vLLM / Ollama)
VLLM_BASE_URL=http://localhost:8000/v1
OLLAMA_BASE_URL=http://localhost:11434/v1

# Caching Configuration
CACHE_DIR=.cache/omnivision
REDIS_URL=redis://localhost:6379/0
ENABLE_REDIS_CACHE=false

# Compute & Device Configuration
OMNIVISION_DEVICE=auto
OMNIVISION_GPU_MEMORY_FRACTION=0.85
OMNIVISION_CACHE_TTL_SECONDS=86400
LOG_LEVEL=INFO
