# ==============================================================================
# OmniVision Agent Studio - Environment Configuration Template
# Copy this file to .env and set your credentials:
#   cp .env.example .env
# ==============================================================================

# Google Gemini API Key (Required)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Application URL (Optional, defaults to http://localhost:3000)
# Used for server routing and webhook/callback references
APP_URL=http://localhost:3000
